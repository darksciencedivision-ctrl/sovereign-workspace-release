# ADR-005 (F-064b): dependency lifecycle scripts are blocked by default.
#
# `npm ci`/`npm install` otherwise run every dependency's preinstall/install/postinstall script,
# including Electron's postinstall, which downloads an unverified prebuilt binary from an external
# host. ADR-005 exists to prevent exactly that. With this tracked, CI provisioning and any
# developer install honour package-lock without executing arbitrary install-time code.
#
# A build that genuinely needs Electron's binary (packaging the desktop app for distribution)
# fetches it through a separate, audited step, not through an implicit dependency script.
ignore-scripts=true
