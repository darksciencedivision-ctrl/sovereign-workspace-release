{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sovereign.local/schemas/evidence@1.0",
  "title": "Evidence record",
  "description": "Evidence entries back gate verdicts and debate assertions (Plan section 19.2: citations must resolve to real MCP entries; unsupported claims are marked as such — model votes are not evidence).",
  "type": "object",
  "required": ["evidence_id", "kind", "summary", "produced_by_node", "ts", "confidence"],
  "additionalProperties": false,
  "properties": {
    "evidence_id": { "type": "string", "pattern": "^e-[A-Za-z0-9_-]+$" },
    "kind": { "enum": ["test_output", "measurement", "benchmark", "document", "citation", "log", "reproduction"] },
    "summary": { "type": "string", "minLength": 1 },
    "artifact_refs": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
    "produced_by_node": { "type": "string" },
    "task_id": { "type": ["string", "null"] },
    "ts": { "type": "string", "format": "date-time" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "supported"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "supported": { "type": "boolean" },
          "source": { "type": ["string", "null"] }
        }
      }
    },
    "schema": { "const": "evidence@1.0" }
  }
}
