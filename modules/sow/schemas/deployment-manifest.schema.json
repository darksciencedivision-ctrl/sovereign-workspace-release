{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-manifest.schema.json",
  "title": "Deployment manifest",
  "type": "object",
  "required": [
    "artifact_id", "model_id", "source_identity", "source_hash", "artifact_hash",
    "format", "quantization", "runtime_compatibility", "creation_tool",
    "creation_tool_version", "creation_timestamp", "validated_context", "status"
  ],
  "properties": {
    "artifact_id": {"type": "string"},
    "model_id": {"type": "string"},
    "source_identity": {"type": "string"},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "format": {"type": "string"},
    "quantization": {"type": "string"},
    "runtime_compatibility": {"type": "array", "items": {"type": "string"}},
    "creation_tool": {"type": "string"},
    "creation_tool_version": {"type": "string"},
    "creation_timestamp": {"type": "string"},
    "validated_context": {"type": ["integer", "null"]},
    "status": {"type": "string", "enum": ["CANDIDATE", "RESEARCH", "WITHDRAWN"]}
  },
  "additionalProperties": true
}
