# ADR-005 (F-064b): dependency lifecycle scripts are blocked by default.
#
# `npm ci`/`npm install` otherwise run every dependency's preinstall/install/postinstall script.
# ADR-005 blocks install-time code execution across the product's Node trees. With this tracked,
# CI provisioning and any developer install honour package-lock without executing arbitrary
# install-time code.
ignore-scripts=true
