{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://distillery.local/schema/shard.json",
  "title": "Immutable treaty training sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "source_trace_id", "content", "content_hash", "channel", "harness", "provider", "teacher_of_record", "source_revision", "source_admission_class", "generation_depth", "seed_trace_ids", "seed_ref", "derived_from", "validator_results", "labels", "client_tag", "trace_fit_version", "normalizer_version", "created_at"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "source_trace_id": {"type": "string", "minLength": 1},
    "content": {},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "channel": {"enum": ["CH1", "CH1-E", "CH2", "CH3", "CH-W", "CH-M", "REPLAY"]},
    "harness": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "teacher_of_record": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "source_admission_class": {"enum": ["ELIGIBLE", "INTERNAL_ONLY"]},
    "generation_depth": {"type": "integer", "minimum": 0, "maximum": 2},
    "seed_trace_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "seed_ref": {"type": ["string", "null"]},
    "derived_from": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "validator_results": {"type": "array"},
    "labels": {"type": "object"},
    "client_tag": {"type": "string", "minLength": 1},
    "trace_fit_version": {"type": "string", "minLength": 1},
    "normalizer_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
