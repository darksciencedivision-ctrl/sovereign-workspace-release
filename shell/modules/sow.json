{
  "id": "sow",
  "display_name": "Multi-Model Terminal",
  "description": "Sovereign Orchestration Workspace (Electron + xterm.js)",
  "state_class": "runnable",
  "root": "${install_root}/modules/sow",
  "runtime_writes": [
    "${state_root}/.recovery",
    "${state_root}/receipts",
    "${state_root}/store",
    "${state_root}/.approvals",
    "${state_root}/journal"
  ],
  "launch": {
    "cwd": "${root}/apps/desktop",
    "argv": [
      "${root}/apps/desktop/node_modules/electron/dist/electron.exe",
      "."
    ],
    "env_allowlist": [
      "SYSTEMROOT",
      "PATH",
      "TEMP",
      "TMP",
      "USERPROFILE",
      "LOCALAPPDATA",
      "APPDATA",
      "ProgramFiles",
      "ProgramW6432",
      "SOVEREIGN_INFERENCE_BACKEND",
      "SOVEREIGN_LLAMACPP_HOST",
      "SOVEREIGN_LLAMA_CPP_BASE_URL",
      "SOVEREIGN_LLAMA_CPP_API_KEY",
      "SOVEREIGN_LLAMA_SUPERVISOR_ROOT",
      "SOW_CODING_BASE_REPO"
    ],
    "env_set": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "SOW_CONDUCTOR_AUTOLAUNCH": "0",
      "SOVEREIGN_STORE_ROOT": "${state_root}/store"
    }
  },
  "readiness": {
    "kind": "receipt_file",
    "path": "${state_root}/receipts/SHELL-LIVE-READY.json",
    "require": {
      "ok": true,
      "supervised": true
    },
    "timeout_s": 90,
    "poll_ms": 1000
  },
  "identity": {
    "kind": "process_image"
  },
  "open": {
    "kind": "focus_window"
  },
  "stop": {
    "kind": "job_object",
    "grace_s": 15
  },
  "startup_test": {
    "env_set": {
      "SHELL_SELFCHECK": "1",
      "SHELL_SELFCHECK_RECEIPT_DIR": "${state_root}/receipts"
    },
    "readiness": {
      "kind": "receipt_file",
      "path": "${state_root}/receipts/PHASE16A_SELFCHECK.json",
      "require": {
        "ok": true
      },
      "timeout_s": 90,
      "poll_ms": 1000
    }
  }
}
