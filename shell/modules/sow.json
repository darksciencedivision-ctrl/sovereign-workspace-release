{
  "id": "sow",
  "display_name": "Multi-Model Terminal",
  "description": "Sovereign Orchestration Workspace (Electron + xterm.js)",
  "state_class": "runnable",
  "root": "D:\\producttion software 2\\release-worktree\\modules\\sow",
  "runtime_writes": [
    "${root}/apps/desktop/.recovery",
    "${root}/.runtime/receipts"
  ],
  "launch": {
    "cwd": "${root}/apps/desktop",
    "argv": [
      "${root}/apps/desktop/node_modules/electron/dist/electron.exe",
      "."
    ],
    "env_allowlist": [
      "SYSTEMROOT",
      "PATH",
      "TEMP",
      "TMP",
      "USERPROFILE",
      "LOCALAPPDATA",
      "APPDATA"
    ],
    "env_set": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "SOW_CONDUCTOR_AUTOLAUNCH": "0",
      "SOW_OPERATOR_TEXT_DRIVER_PORT": "17890"
    }
  },
  "readiness": {
    "kind": "receipt_file",
    "path": "${root}/.runtime/receipts/SHELL-LIVE-READY.json",
    "timeout_s": 90,
    "poll_ms": 1000
  },
  "identity": {
    "kind": "process_image"
  },
  "open": {
    "kind": "focus_window"
  },
  "stop": {
    "kind": "job_object",
    "grace_s": 15
  },
  "startup_test": {
    "env_set": {
      "SHELL_SELFCHECK": "1"
    },
    "readiness": {
      "kind": "receipt_file",
      "path": "${root}/docs/evidence/receipts/PHASE16A_SELFCHECK.json",
      "require": {
        "ok": true
      },
      "timeout_s": 90,
      "poll_ms": 1000
    }
  }
}
