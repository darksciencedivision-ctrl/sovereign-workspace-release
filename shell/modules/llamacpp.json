{
  "id": "llamacpp",
  "display_name": "llama.cpp (local supervisor)",
  "description": "The workspace-wide local inference router on loopback port 18080. The outer workspace launcher starts the existing user-level supervisor; every module and picker attaches to this endpoint without an Ollama or cloud fallback.",
  "state_class": "runnable",
  "root": "${install_root}/modules/sovereign",
  "runtime_writes": [
    "${state_root}/logs"
  ],
  "launch": {
    "cwd": "${root}",
    "argv": [
      "${root}/.venv/Scripts/python.exe",
      "-m",
      "sovereign_product.supervisor_service",
      "--root",
      "${root}",
      "--port",
      "18080",
      "watch"
    ],
    "env_allowlist": [
      "SYSTEMROOT",
      "PATH",
      "TEMP",
      "TMP",
      "SOVEREIGN_INFERENCE_BACKEND",
      "SOVEREIGN_LLAMACPP_HOST",
      "SOVEREIGN_LLAMA_CPP_BASE_URL",
      "SOVEREIGN_LLAMA_CPP_API_KEY",
      "SOVEREIGN_LLAMA_SUPERVISOR_ROOT",
      "SOVEREIGN_LLAMACPP_SERVER_EXE",
      "SOVEREIGN_LLAMACPP_SERVER_SHA256",
      "SOVEREIGN_LLAMACPP_IMPL_SHA256",
      "SOVEREIGN_FREETOKEN_ENV",
      "SOVEREIGN_FREETOKEN_EXE",
      "SOVEREIGN_FREETOKEN_CUDA_HOME",
      "SOVEREIGN_FREETOKEN_MODEL",
      "SOVEREIGN_FREETOKEN_MOE_MODEL"
    ],
    "env_set": {
      "PYTHONDONTWRITEBYTECODE": "1"
    }
  },
  "readiness": {
    "kind": "http",
    "url": "http://127.0.0.1:18080/models",
    "expect_status": 200,
    "timeout_s": 30,
    "poll_ms": 400
  },
  "identity": {
    "kind": "http_json",
    "url": "http://127.0.0.1:18080/models",
    "required_keys": [
      "data"
    ]
  },
  "open": {
    "kind": "none"
  },
  "stop": {
    "kind": "job_object",
    "grace_s": 8
  }
}
