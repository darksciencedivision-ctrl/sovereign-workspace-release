{
  "id": "tokencenter",
  "display_name": "Token Center",
  "description": "Read-only local usage telemetry. No credentials.",
  "state_class": "runnable",
  "root": "${install_root}/modules/tokencenter",
  "runtime_writes": [
    "${state_root}/data"
  ],
  "launch": {
    "cwd": "${root}",
    "argv": [
      "${python312}",
      "${root}/piggybank.py",
      "--port",
      "8765"
    ],
    "env_allowlist": [
      "SYSTEMROOT",
      "PATH",
      "TEMP",
      "TMP",
      "USERPROFILE",
      "LOCALAPPDATA",
      "APPDATA"
    ],
    "env_set": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "TOKENCENTER_DATA_DIR": "${state_root}/data"
    }
  },
  "readiness": {
    "kind": "http",
    "url": "http://127.0.0.1:8765/healthz",
    "expect_status": 200,
    "timeout_s": 20,
    "poll_ms": 250
  },
  "identity": {
    "kind": "http_json",
    "url": "http://127.0.0.1:8765/healthz",
    "required_keys": [
      "ok",
      "collector_error"
    ]
  },
  "open": {
    "kind": "browser",
    "url": "http://127.0.0.1:8765/"
  },
  "stop": {
    "kind": "job_object",
    "grace_s": 5
  }
}
