{
  "id": "debate",
  "display_name": "Debate Table",
  "description": "Multi-model debate table (FastAPI, :8700)",
  "state_class": "runnable",
  "root": "D:\\producttion software 2\\release-worktree\\modules\\debate",
  "runtime_writes": [
    "${state_root}/config.json",
    "${state_root}/logs"
  ],
  "launch": {
    "cwd": "${root}",
    "argv": [
      "${root}/.venv/Scripts/python.exe",
      "app.py"
    ],
    "env_allowlist": [
      "SYSTEMROOT",
      "PATH",
      "TEMP",
      "TMP",
      "USERPROFILE",
      "LOCALAPPDATA",
      "APPDATA"
    ],
    "env_set": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "DEBATE_LOG_DIR": "${state_root}/logs",
      "CONFIG_PATH": "${state_root}/config.json"
    }
  },
  "readiness": {
    "kind": "http",
    "url": "http://127.0.0.1:8700/",
    "expect_status": 200,
    "timeout_s": 30,
    "poll_ms": 500
  },
  "identity": {
    "kind": "http_html_marker",
    "url": "http://127.0.0.1:8700/",
    "html_marker": "Debate Table"
  },
  "open": {
    "kind": "browser",
    "url": "http://127.0.0.1:8700/"
  },
  "stop": {
    "kind": "job_object",
    "grace_s": 10
  }
}
