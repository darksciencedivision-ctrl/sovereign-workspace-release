{
  "id": "sovereign",
  "display_name": "SOVEREIGN",
  "description": "Operator product service and UI (Flask, :5175)",
  "maturity": "preview",
  "state_class": "runnable",
  "root": "${install_root}/modules/sovereign",
  "runtime_writes": [
    "${root}/runtime",
    "${root}/published",
    "${root}/library/queues",
    "${state_root}/logs"
  ],
  "launch": {
    "cwd": "${root}",
    "argv": [
      "${root}/.venv/Scripts/python.exe",
      "-m",
      "sovereign_product.server",
      "--root",
      "${root}",
      "--host",
      "127.0.0.1",
      "--port",
      "5175",
      "--workers",
      "1"
    ],
    "env_allowlist": [
      "SYSTEMROOT",
      "PATH",
      "TEMP",
      "TMP",
      "USERPROFILE",
      "LOCALAPPDATA",
      "APPDATA",
      "SOVEREIGN_INFERENCE_BACKEND",
      "SOVEREIGN_LLAMACPP_HOST",
      "SOVEREIGN_LLAMA_CPP_BASE_URL",
      "SOVEREIGN_LLAMA_CPP_API_KEY",
      "SOVEREIGN_LLAMA_SUPERVISOR_ROOT",
      "SOVEREIGN_LLAMACPP_SERVER_EXE",
      "SOVEREIGN_LLAMACPP_SERVER_SHA256",
      "SOVEREIGN_LLAMACPP_IMPL_SHA256",
      "SOVEREIGN_FREETOKEN_ENV",
      "SOVEREIGN_FREETOKEN_EXE",
      "SOVEREIGN_FREETOKEN_CUDA_HOME",
      "SOVEREIGN_FREETOKEN_MODEL",
      "SOVEREIGN_FREETOKEN_MOE_MODEL"
    ],
    "env_set": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "SOVEREIGN_STATE_DIR": "${root}/runtime",
      "SOVEREIGN_EVIDENCE_DIR": "${root}/runtime/evidence"
    }
  },
  "readiness": {
    "kind": "http",
    "url": "http://127.0.0.1:5175/v1/health",
    "expect_status": 200,
    "timeout_s": 45,
    "poll_ms": 500
  },
  "identity": {
    "kind": "http_json",
    "url": "http://127.0.0.1:5175/v1/health",
    "required_keys": [
      "status",
      "product_version",
      "loopback_only"
    ],
    "require": {
      "loopback_only": true
    }
  },
  "open": {
    "kind": "browser",
    "url": "http://127.0.0.1:5175/"
  },
  "stop": {
    "kind": "job_object",
    "grace_s": 10
  }
}
