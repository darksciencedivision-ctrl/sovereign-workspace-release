{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sws-adapter-v1",
  "title": "SWS Module Adapter Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "description",
    "state_class",
    "root"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "maturity": {
      "type": "string",
      "description": "Honest release maturity of the module, surfaced on its workspace tile so a pre-functional module is not presented as a finished peer product. Optional; absent is treated as 'unspecified'.",
      "enum": [
        "stable",
        "beta",
        "preview",
        "alpha",
        "unspecified"
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "runnable",
        "not_started"
      ]
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "type": "string",
      "description": "SW-18: who owns the module's process. 'owned' (default): the shell launches it inside its Job Object and stops it (graceful shutdown Event, then TerminateJobObject). 'attached': a persistent service run by something else (a user-level supervisor, a Windows service); the shell only observes it (http readiness + http identity) and never launches, stops, restarts or tests it, so launch/stop/startup_test are forbidden.",
      "enum": ["owned", "attached"],
      "default": "owned"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "description": "SW-18: operator-facing hints for an attached service - how to start/stop it outside the shell. Only valid when lifecycle is 'attached'.",
      "properties": {
        "start_hint": { "type": "string", "minLength": 1, "maxLength": 256 },
        "stop_hint": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "runtime_writes": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["dir", "file"] }
            },
            "required": ["path", "kind"],
            "additionalProperties": false
          }
        ]
      },
      "default": []
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cwd",
        "argv"
      ],
      "properties": {
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 32
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "SYSTEMROOT",
            "PATH",
            "TEMP",
            "TMP",
            "USERPROFILE",
            "LOCALAPPDATA",
            "APPDATA"
          ]
        },
        "env_set": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "timeout_s",
        "poll_ms"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "http",
            "process_window",
            "receipt_file"
          ]
        },
        "url": {
          "type": "string"
        },
        "expect_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "path": {
          "type": "string"
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "poll_ms": {
          "type": "integer",
          "minimum": 250,
          "maximum": 5000
        },
        "require": {
          "type": "object",
          "description": "F-130: required key/value pairs the receipt JSON must satisfy (receipt_file readiness); defaults to {\"ok\": true} when absent."
        },
        "require_json": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          },
          "description": "SW-13: functional-readiness contract for an http health endpoint. Key/value pairs the health JSON body must satisfy for the module to count as READY; a 200 whose body fails any pair is LIVE but DEGRADED (the tile shows degraded + the payload's reason, and the process is kept so poll can flip it to READY when the backend recovers). Only valid when kind is http; values are JSON scalars the product emits (e.g. {\"ok\": true})."
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "description": "F-034: identity confirms the service on the port is the intended KIND of product module, not a cryptographically authenticated instance. http_json requires required_keys and optional require value pins (product-emitted fields, never a self-named service label); http_html_marker requires a UI marker; process_image compares the OS-reported image of the spawned pid to compiled argv[0]. This rejects the wrong module, a stale foreign listener, and malformed bodies. It is not proof against a co-located adversary standing up a look-alike; that would need a per-launch shared secret (SWS_SHELL_NONCE / F-006).",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "http_json",
            "http_html_marker",
            "process_image"
          ]
        },
        "url": {
          "type": "string"
        },
        "required_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "html_marker": {
          "type": "string"
        },
        "require": {
          "type": "object",
          "description": "F-034: required key/value pairs the identity JSON must satisfy in addition to required_keys. Values must be product-emitted fields, not a tautological service name."
        }
      }
    },
    "open": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "browser",
            "focus_window",
            "none"
          ]
        },
        "url": {
          "type": "string"
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "grace_s"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "job_object"
          ]
        },
        "grace_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "startup_test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env_set": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "receipt_file"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "require": {
              "type": "object"
            },
            "timeout_s": {
              "type": "integer",
              "minimum": 5,
              "maximum": 120
            },
            "poll_ms": {
              "type": "integer",
              "minimum": 250,
              "maximum": 5000
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state_class": { "const": "runnable" },
          "lifecycle": { "const": "attached" }
        },
        "required": ["lifecycle"]
      },
      "then": {
        "required": ["readiness", "identity", "open"],
        "not": { "anyOf": [
          { "required": ["launch"] },
          { "required": ["stop"] },
          { "required": ["startup_test"] }
        ] }
      },
      "else": {
        "if": {
          "properties": {
            "state_class": {
              "const": "runnable"
            }
          }
        },
        "then": {
          "required": [
            "launch",
            "readiness",
            "identity",
            "open",
            "stop"
          ]
        }
      }
    }
  ]
}
