+    recordConversationContext: (out, result) => { out.workspace_view = result.context; } };
+  vm.createContext(box);
+  await vm.runInContext("(async () => {" + voice + "})()", box);
+  assert.equal(written, "hello"); assert.equal(received.channel, "voice");
+  assert.match(received.workspace_view.notice, /No worker view attached/);
+});
