+    delegateToPane: async (a, b) => { io = a; args = b; return answer; },
+    readinessWindow: {}, paneWriter: { writePrompt() {} }, pause() {}, log() {} };
+  vm.createContext(box);
+  vm.runInContext(region(main, "async function delegateToWorkerPane(", "/**\n * THE LOOP"), box);
+  const task = { task_id: "objective-1", objective: "same task" }, options = { timeoutMs: 20 };
+  const result = await box.delegateToWorkerPane("pane-2", "node-2", task, options);
+  assert.equal(result, answer); assert.equal(args.task, task); assert.equal(args.timeoutMs, 20);
+  assert.equal(io.window, box.readinessWindow); assert.equal(tally.count(journal, "pane-2"), 1);
+});
+test("F-38: main associates the actual view notice and honesty markers with the sent turn", () => {
+  const turns = [], box = { pushTranscriptTurn: t => turns.push(t) };
+  vm.createContext(box);
+  vm.runInContext(region(main, "function recordConversationContext(", "async function handleOperatorText("), box);
+  const out = { dir: "out" }, context = V.composeView("hello", [], p);
