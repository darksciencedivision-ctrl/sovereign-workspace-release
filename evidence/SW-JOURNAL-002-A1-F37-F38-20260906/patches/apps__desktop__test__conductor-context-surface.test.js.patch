+"use strict";
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs"), path = require("node:path"), vm = require("node:vm");
+const V = require("../control/conductor-view");
+const rendererPath = path.resolve(__dirname, "../renderer/renderer.js");
+const renderer = fs.readFileSync(rendererPath, "utf8");
+const html = fs.readFileSync(path.resolve(__dirname, "../renderer/index.html"), "utf8");
+const main = fs.readFileSync(path.resolve(__dirname, "../main.js"), "utf8");
+function region(source, begin, end) {
+  const a = source.indexOf(begin), b = source.indexOf(end, a);
+  assert.ok(a >= 0 && b > a, begin); return source.slice(a, b);
+}
+class Element {
+  constructor() { this.children = []; this.events = {}; this.attrs = {}; this.value = ""; this.hidden = false; this.text = ""; }
+  set textContent(s) { this.text = String(s); this.children = []; }
+  get textContent() { return this.text + this.children.map(c => c.textContent).join(""); }
+  appendChild(c) { this.children.push(c); return c; }
+  setAttribute(k, v) { this.attrs[k] = v; }
+  addEventListener(k, fn) { this.events[k] = fn; }
+}
+function surface(source = renderer) {
+  const ids = new Map(["conductor-input", "conductor-send", "conductor-transcript", "conductor-transcript-toggle",
+    "conductor-context-notice", "conductor-form", "conductor-delegate", "conductor-delegate-why", "btn-clear"]
+    .map(id => [id, new Element()]));
+  let receive;
+  const sandbox = { document: { getElementById: id => ids.get(id) || null,
+    createElement: () => new Element(), readyState: "complete" },
+    S: { onConductorTranscript: cb => { receive = cb; } },
+    localStorage: { getItem: () => null, setItem() {} }, requestAnimationFrame: fn => fn(),
+    terms: new Map(), window: {}, conductor: null, console };
+  vm.runInNewContext(region(source, "function workspaceViewNotice(turn)", "// ---- routing/artifact inspector drawer"), sandbox);
+  assert.equal(typeof receive, "function");
+  return { ids, receive };
+}
+const p = { available: true, num_ctx: 8000, reserved_prompt_tokens: 0,
+  reserved_response_tokens: 0, chars_per_token: 1, total_max_chars: 8000, max_observation_chars: 8000 };
+function turn(context) { return { utc: "2026-09-06T00:00:00Z", dir: "out", text: "hello", workspace_view: context }; }
+function noViewContract(source) {
+  const ui = surface(source), context = V.composeView("hello", [], p);
+  ui.receive([turn(context)]);
+  assert.equal(ui.ids.get("conductor-transcript").hidden, true);
+  assert.match(ui.ids.get("conductor-transcript").textContent, /No worker view attached.*\/workspace/);
+  assert.match(ui.ids.get("conductor-transcript-toggle").textContent, /^No view · \/workspace/);
+  assert.match(ui.ids.get("conductor-context-notice").textContent, /No worker view attached.*\/workspace/);
+  ui.ids.get("conductor-transcript-toggle").events.click();
+  assert.equal(ui.ids.get("conductor-transcript").hidden, false);
+  assert.match(ui.ids.get("conductor-transcript").textContent, /No worker view attached.*\/workspace/);
+}
+test("F-38: real renderer retains the no-view notice on its turn and when collapsed", () => {
+  noViewContract(renderer);
+  assert.match(html, /id="conductor-context-notice" aria-live="polite"><\/div>\s*<div id="conductor-transcript"/);
+  assert.match(html, /#conductor-context-notice\s*\{[^}]*overflow-wrap:\s*anywhere/);
+});
+test("F-38: actual renderer distinguishes attached-empty from journal-unavailable and no-view", () => {
+  const ui = surface();
+  const states = [V.composeView("hello", [], p), V.composeView("what did they all say", [], p),
+    V.composeView("what did they all say", [], p, "Worker journal unavailable")];
+  const rendered = [];
+  for (const ctx of states) {
+    ui.receive([turn(ctx)]);
+    rendered.push(ui.ids.get("conductor-context-notice").textContent);
+  }
+  assert.match(rendered[0], /No worker view attached/);
+  assert.match(rendered[1], /attached but empty/);
+  assert.match(rendered[2], /journal unavailable/i);
+  assert.equal(new Set(rendered).size, 3);
+  ui.receive([]);
+  assert.equal(ui.ids.get("conductor-context-notice").textContent, "");
+  assert.doesNotMatch(ui.ids.get("conductor-transcript-toggle").textContent, /Journal unavailable/);
+});
+test("F-38: entry count, source panes and truncation render as text, not HTML", () => {
+  const ui = surface();
+  const notice = "Worker view attached: 2 entries from terminal #2 (pane-2), terminal #3 (pane-3). TRUNCATED. <script>bad</script>";
+  ui.receive([turn({ state: "attached", truncated: true, notice })]);
+  assert.ok(ui.ids.get("conductor-transcript").textContent.includes(notice));
+  assert.equal(ui.ids.get("conductor-context-notice").textContent, notice);
+  assert.match(ui.ids.get("conductor-transcript-toggle").textContent, /^View TRUNCATED/);
+});
+test("F-38 mutation control: removing the no-view notice from retained turns fails rendering", () => {
+  const anchor = "      const notice = workspaceViewNotice(turn);";
+  assert.equal(renderer.split(anchor).length - 1, 1);
+  noViewContract(renderer);
+  assert.throws(() => noViewContract(renderer.replace(anchor, '      const notice = "";')));
+  assert.equal(fs.readFileSync(rendererPath, "utf8"), renderer);
+});
