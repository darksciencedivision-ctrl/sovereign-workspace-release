+test("F-37: typed and classified voice chat use the same accompaniment before the existing writer", async () => {
+  const shared = region(main, "async function deliverConductorConversation(", "function recordConversationContext(");
+  assert.match(shared, /retrieveAndDeliver/); assert.match(shared, /deliverConductorChat\(body\)/);
