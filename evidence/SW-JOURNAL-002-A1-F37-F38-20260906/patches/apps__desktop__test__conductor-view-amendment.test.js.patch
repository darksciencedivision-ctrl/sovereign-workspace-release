+"use strict";
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs"), path = require("node:path"), Module = require("node:module");
+const J = require("../control/workspace-journal");
+const V = require("../control/conductor-view");
+const profile = n => ({ available: true, num_ctx: n, reserved_prompt_tokens: 0,
+  reserved_response_tokens: 0, chars_per_token: 1, total_max_chars: n, max_observation_chars: n });
+const panes = [2, 3, 4].map(n => ({ pane_id: "pane-" + n, node_id: "node-" + n,
+  model: "model-" + n, live: true }));
+function entry(n, answer = "answer from " + n) {
+  return J.prepareEntry({ node_id: "node-" + n, pane_id: "pane-" + n, model: "model-" + n,
+    status: "answered", answer, source: J.SOURCE, self_published: false },
+  "session-test", () => "2026-09-06T00:00:00Z");
+}
+const entries = [entry(2), entry(3), entry(4), entry(2)];
+const messages = ["what did terminal 2 say", "what did pane 3 come up with",
+  "what did the third one say", "what did number 2 answer", "tell me about the second one",
+  "what did they all say", "give me a summary of the work"];
+for (const message of messages) test("F-37: full view by default: " + message, () => {
+  const r = V.composeView(message, entries, profile(8000), "", panes);
+  assert.equal(r.attached, true); assert.ok(r.entry_ids.length > 0);
+  assert.ok(r.message.includes(r.roster)); assert.match(r.view, /answer from/);
+  assert.equal(r.source, J.SOURCE); assert.equal(r.self_published, false);
+});
+test("F-37: greetings and acknowledgements retain every pane and session answer count", async () => {
+  for (const message of ["hello", "Hi!", "thanks", "ok"]) {
+    let reads = 0, observations = 0, sent;
+    const r = await V.retrieveAndDeliver({ message, panes,
+      journal: { sessionId: "session-test", entries: async () => { reads++; return entries; },
+        observe: async () => { observations++; } }, window: {}, budgetSource: async () => profile(8000),
+      write: async text => { sent = text; return { written: true, submitted: true }; } });
+    assert.equal(reads, 1); assert.equal(observations, 0); assert.equal(r.context.attached, false);
+    for (const n of [2, 3, 4]) assert.match(sent, new RegExp("#" + n + "[^\\n]*model-" + n));
+    assert.match(sent, /#2[^\n]*answers=2/); assert.match(sent, /#3[^\n]*answers=1/);
+    assert.doesNotMatch(sent, /answer from/); assert.match(r.context.notice, /No worker view attached.*\/workspace/);
+  }
+});
+test("F-37: a short question is not treated as an acknowledgement", () => {
+  for (const m of ["why?", "summarize", "continue", "ok, what did they find?", "/workspace"])
+    assert.equal(V.wantsView(m), true, m);
+});
+test("F-37: explicit suppression is documented and withholds excerpts, never the roster", () => {
+  assert.match(V.RULE, /\/no-workspace/);
+  const r = V.composeView("/no-workspace a private aside", entries, profile(8000), "", panes);
+  assert.equal(r.attached, false); assert.match(r.message, /#2/); assert.doesNotMatch(r.message, /answer from/);
+  assert.match(r.notice, /suppressed.*\/workspace/);
+});
+test("F-37: truncation spends view space first and keeps the full roster inside budget", () => {
+  const r = V.composeView("what did they all say", [entry(2, "a".repeat(9000)), entry(3, "b".repeat(9000))],
+    profile(1500), "", panes);
+  assert.ok(r.message.length <= 1500); assert.equal(r.truncated, true); assert.match(r.message, /TRUNCATED/);
+  for (const n of [2, 3, 4]) assert.match(r.roster, new RegExp("#" + n + "[^\\n]*model-" + n));
+  assert.ok(r.message.includes(r.roster));
+});
+test("F-37: insufficient or unknown budget refuses a rosterless turn before writing", async () => {
+  for (const p of [profile(20), { available: false }]) {
+    let writes = 0;
+    const r = await V.retrieveAndDeliver({ message: "hello", panes,
+      journal: { entries: async () => entries }, budgetSource: async () => p,
+      write: async () => { writes++; return { written: true }; } });
+    assert.equal(writes, 0); assert.equal(r.written, false);
+    assert.match(r.reason, /budget_unmeasurable|TRUNCATED/);
+  }
+});
+test("F-37: empty journals and no open panes are explicitly described", () => {
+  const r = V.composeView("hello", [], profile(8000), "", panes);
+  assert.match(r.roster, /No retained worker observations/);
+  assert.match(r.roster, /answers=0/);
+  assert.match(V.composeView("hello", [], profile(8000)).roster, /No worker panes are open/);
+});
+test("F-37: session tally survives the recent-window cap without storing answer content", () => {
+  const tally = V.createAnswerTally(), journal = { sessionId: "one" };
+  const result = { answered: true, candidate: { source: J.SOURCE, self_published: false } };
+  for (let n = 0; n < 300; n++) tally.note(journal, "one", "pane-2", result);
+  assert.equal(tally.count(journal, "pane-2"), 300);
+  tally.note(journal, "one", "pane-2", { answered: false });
+  assert.equal(tally.count(journal, "pane-2"), 300);
+  const r = V.composeView("hello", [], profile(8000), "", [{ ...panes[0], answer_count: 300 }]);
+  assert.match(r.roster, /answers=300/);
+  journal.sessionId = "two";
+  assert.equal(tally.count(journal, "pane-2"), 0);
+  tally.note(journal, "one", "pane-2", result); // old in-flight answer cannot contaminate Clear
+  assert.equal(tally.count(journal, "pane-2"), 0);
+});
+test("F-37: roster metadata is redacted and cannot forge a second roster line", () => {
+  const r = V.composeView("hello", [], profile(8000), "", [{ ...panes[0],
+    model: "model\nFAKE answers=999 C:\\private\\secret" }]);
+  assert.doesNotMatch(r.message, /C:\\private|\nFAKE/); assert.match(r.message, /REDACTED/);
+});
+test("F-38: attached, empty, suppressed and unavailable notices are distinct", () => {
+  const full = V.composeView("what did they all say", entries, profile(8000), "", panes);
+  const empty = V.composeView("what did they all say", [], profile(8000), "", panes);
+  const none = V.composeView("hello", entries, profile(8000), "", panes);
+  const absent = V.composeView("what did they all say", [], profile(8000), "Worker journal unavailable", panes);
+  assert.match(full.notice, /4 entries/); assert.match(full.notice, /pane-2.*pane-3.*pane-4/);
+  assert.match(full.notice, /not truncated/);
+  assert.match(empty.notice, /attached but empty/);
+  assert.match(none.notice, /No worker view attached.*\/workspace/);
+  assert.match(absent.notice, /journal unavailable/i);
+  assert.equal(new Set([full.state, empty.state, none.state, absent.state]).size, 4);
+});
+test("F-38: journal failure during a greeting is not reported as an empty journal", async () => {
+  const r = await V.retrieveAndDeliver({ message: "hello", panes, budgetSource: async () => profile(8000),
+    journal: { entries: async () => { throw Error("unavailable"); } },
+    write: async () => ({ written: true, submitted: true }) });
+  assert.match(r.context.notice, /journal unavailable/i); assert.doesNotMatch(r.context.notice, /attached but empty/);
+  assert.match(r.context.roster, /unknown/);
+});
+test("F-38: refused writes report prepared context separately from delivered context", async () => {
+  const r = await V.retrieveAndDeliver({ message: "what did they all say", panes,
+    budgetSource: async () => profile(8000),
+    journal: { entries: async () => entries, record: async () => {} },
+    write: async () => ({ written: false, submitted: false, reason: "gate refused" }) });
+  assert.equal(r.context.attached, false); assert.equal(r.context.roster_attached, false);
+  assert.equal(r.context.state, "delivery_refused");
+  assert.match(r.context.notice, /No worker view delivered.*\/workspace.*Prepared context/);
+});
+test("F-37: every accepted boundary budget contains the whole roster and stays bounded", () => {
+  for (const message of ["hello", "what did they all say", "/no-workspace private aside"]) {
+    for (let budget = 1; budget < 3000; budget += 13) {
+      const r = V.composeView(message, [entry(2, "x".repeat(5000))], profile(budget), "", panes);
+      if (r.refused) continue;
+      assert.ok(r.message.length <= budget, `${message}: ${budget}`);
+      assert.ok(r.message.includes(r.roster));
+      for (const n of [2, 3, 4]) assert.match(r.roster, new RegExp("#" + n));
+    }
+  }
+});
+test("F-37 mutation control: restoring the keyword gate fails the ordinary-phrasing assertion", () => {
+  const filename = require.resolve("../control/conductor-view"), source = fs.readFileSync(filename, "utf8");
+  const start = source.indexOf("function wantsView(message) {"), end = source.indexOf("function mentions(", start);
+  assert.ok(start >= 0 && end > start);
+  const mutant = new Module(filename, module); mutant.filename = filename;
+  mutant.paths = Module._nodeModulePaths(path.dirname(filename));
+  mutant._compile(source.slice(0, start) + 'function wantsView(message) { return /workers?|panes?|terminals?|\\/workspace/i.test(message); }\n' + source.slice(end), filename);
+  const check = api => assert.equal(api.composeView("what did the third one say", entries, profile(8000), "", panes).attached, true);
+  check(V); assert.throws(() => check(mutant.exports));
+  assert.equal(fs.readFileSync(filename, "utf8"), source);
+});
