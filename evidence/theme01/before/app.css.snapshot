/* ============================================================
   Sovereign Workspace Shell — app.css (SWS-UI-001 v1.2)
   - Theme tokens as CSS custom properties on :root
   - No gradients, no glow; box-shadows avoided entirely
     (focus uses outline instead)
   - Spacing scale: 4 / 8 / 12 / 16 / 24 px
   - Transitions <= 150 ms
   - Contrast (dark): --text #c7d1de on --bg #0b0e14  ~ 12.5:1
                      --text #c7d1de on --panel #151b28 ~ 11.2:1
     Contrast (light): --text #1b2027 on --bg #f4f5f7  ~ 14.9:1
                       --text #1b2027 on --panel #ffffff ~ 16.3:1
   ============================================================ */

:root {
  --bg: #0b0e14;
  --panel: #151b28;
  --sidebar: #0d121c;
  --input: #1b2333;
  --border: #232b3a;
  --text: #c7d1de;
  --text-muted: #9aa7bd;
  --text-faint: #3a4353;
  --accent: #bb9af7;
  --accent-dim: #3a2f57;
  --ok: #9ece6a;
  --warning: #e0af68;
  --danger: #f7768e;
  --radius: 6px;
  --font: ui-monospace, monospace;
  --mono: "Cascadia Code", Consolas, monospace;
}

@media (prefers-color-scheme: light) {
  :root {
    --bg: #f4f5f7;
    --panel: #ffffff;
    --sidebar: #eceef1;
    --border: #d3d8e0;
    --text: #1b2027;
    --text-muted: #58616e;
    --text-faint: #8a93a1;
    --accent: #8a744a;
    --accent-dim: #a68b58;
  }
  .badge.badge-ok, .badge.badge-warning, .badge.badge-danger { color: var(--text); }
  .badge.badge-ok .dot { background: var(--ok); border: 1px solid var(--ok); }
  .badge.badge-warning .dot { background: var(--warning); border: 1px solid var(--warning); }
  .badge.badge-danger .dot { background: var(--danger); border: 1px solid var(--danger); }
}

/* ---------- reset ---------- */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font);
  font-size: 14px;
  line-height: 1.5;
}

/* ---------- layout ---------- */

.shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 24px 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* ---------- header ---------- */

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  background: var(--sidebar);
  border: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 16px;
}

.header-brand {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}

.header-title {
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--accent);
}

.header-ver,
.header-build,
.header-host {
  color: var(--text-muted);
  font-size: 12px;
  font-family: var(--mono);
}

.header-sep {
  color: var(--text-faint);
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.header-nav {
  display: flex;
  gap: 12px;
}

.header-link {
  color: var(--text-muted);
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.06em;
  padding: 4px 0;
  border-bottom: 1px solid transparent;
  transition: color 120ms ease, border-color 120ms ease;
}

.header-link:hover {
  color: var(--accent);
  border-bottom-color: var(--accent-dim);
}

.header-link:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 2px;
}

.header-clock {
  font-family: var(--mono);
  color: var(--text-muted);
  font-size: 13px;
}

/* ---------- collapsible panels ---------- */

.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.panel-summary {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  cursor: pointer;
  user-select: none;
}

.panel-summary::marker {
  color: var(--accent);
}

.panel-summary:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: -2px;
  border-radius: var(--radius);
}

.summary-title {
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-size: 12px;
  color: var(--text-muted);
}

.summary-note {
  margin-left: auto;
  color: var(--text-faint);
  font-size: 12px;
  font-family: var(--mono);
}

/* ---------- pre-flight ---------- */

.preflight-grid {
  list-style: none;
  margin: 0;
  padding: 4px 16px 16px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 8px 16px;
}

.preflight-item {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.preflight-label {
  color: var(--text);
  font-size: 13px;
  white-space: nowrap;
}

.preflight-detail {
  margin-left: auto;
  color: var(--text-faint);
  font-family: var(--mono);
  font-size: 12px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- dots & badges ---------- */

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--text-faint);
  flex: 0 0 auto;
  transition: background-color 120ms ease;
}

.dot-ok { background: var(--ok); }
.dot-bad { background: var(--danger); }
.dot-unknown { background: var(--warning); }

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
}

.badge .dot {
  background: currentColor;
}

.badge-ok { color: var(--ok); }
.badge-warning { color: var(--warning); }
.badge-danger { color: var(--danger); }
.badge-muted { color: var(--text-muted); }

/* ---------- module grid & cards ---------- */

.module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.module-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.module-name {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.module-desc {
  margin: 0;
  color: var(--text-muted);
  font-size: 13px;
}

.state-line {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.state-reason {
  color: var(--text-muted);
  font-size: 12px;
}

.module-meta {
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.meta-row {
  display: flex;
  gap: 8px;
  font-size: 12px;
}

.meta-label {
  color: var(--text-faint);
  flex: 0 0 100px;
}

.meta-value {
  margin: 0;
  color: var(--text-muted);
  font-family: var(--mono);
  overflow-wrap: anywhere;
}

/* ---------- distillery extras ---------- */

.distillery-links {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  font-size: 12px;
}

.distillery-link {
  color: var(--accent);
  text-decoration: none;
  border-bottom: 1px solid var(--accent-dim);
  padding-bottom: 1px;
  transition: color 120ms ease;
}

.distillery-link:hover {
  color: var(--text);
}

.distillery-link:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.distillery-nolinks {
  color: var(--text-faint);
}

.distillery-note {
  margin: 0;
  color: var(--text-faint);
  font-size: 12px;
  font-style: italic;
  border-left: 2px solid var(--border);
  padding-left: 8px;
}

/* ---------- buttons ---------- */

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: auto;
  padding-top: 4px;
}

.btn {
  appearance: none;
  border: 1px solid var(--accent-dim);
  border-radius: var(--radius);
  background: var(--accent);
  color: var(--bg);
  font-family: var(--font);
  font-size: 13px;
  font-weight: 600;
  padding: 8px 12px;
  cursor: pointer;
  transition: background-color 120ms ease, border-color 120ms ease;
}

.btn:hover:not(:disabled) {
  background: var(--accent-dim);
}

.btn:active:not(:disabled) {
  background: var(--accent-dim);
}

.btn:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.btn-small {
  padding: 4px 8px;
  font-size: 12px;
}

/* ---------- log pane ---------- */

.log-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 4px 16px 12px;
}

.log-status {
  color: var(--text-faint);
  font-size: 12px;
  font-family: var(--mono);
}

.log-output {
  margin: 0;
  background: var(--panel);
  color: var(--text);
  font-family: var(--mono);
  font-size: 12px;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
  max-height: 320px;
  overflow-y: auto;
  padding: 16px;
  border-top: 1px solid var(--border);
  border-radius: 0 0 var(--radius) var(--radius);
}

/* ---------- footer & misc ---------- */

.footer {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
  color: var(--text-faint);
  font-size: 12px;
}

.noscript {
  color: var(--danger);
  margin: 0;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

/* ---------- responsive ---------- */

@media (max-width: 720px) {
  .module-grid {
    grid-template-columns: 1fr;
  }

  .header {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-label {
    flex-basis: 88px;
  }
}
