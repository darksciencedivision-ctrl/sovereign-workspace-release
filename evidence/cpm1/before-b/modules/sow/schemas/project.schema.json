{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sovereign.local/schemas/project@1.0",
  "title": "Project record",
  "description": "Top-level governed project. Project intelligence lives in Sovereign-controlled state exposed through MCP, never in any model session (invariant 5/14).",
  "type": "object",
  "required": ["project_id", "name", "objective", "directive_version", "status", "created_ts"],
  "additionalProperties": false,
  "properties": {
    "project_id": { "type": "string", "pattern": "^p-[A-Za-z0-9_-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1, "description": "Operator-approved objective. Models may not rewrite this field (write authority: operator)." },
    "directive_version": { "type": "string", "description": "e.g. v2.4" },
    "active_profile": { "$ref": "https://sovereign.local/schemas/node@1.0#/definitions/deployment_profile" },
    "status": { "enum": ["PLANNED", "ACTIVE", "PAUSED", "COMPLETE", "ARCHIVED"] },
    "created_ts": { "type": "string", "format": "date-time" },
    "operator": { "type": "string" },
    "canonical_manifest_ref": { "type": ["string", "null"], "description": "sha256 of the freeze manifest governing this project" },
    "registers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision_register_ref": { "type": "string" },
        "unresolved_register_ref": { "type": "string" }
      }
    },
    "schema": { "const": "project@1.0" }
  }
}
