{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sovereign.local/schemas/message@1.0",
  "title": "Control-protocol message envelope",
  "description": "Architecture Plan v1.0.1 section 9.2. Envelopes are the ONLY control channel (TB-2): anything printed by a model or harness in a terminal is untrusted output and is never parsed as a command.",
  "type": "object",
  "required": ["msg_id", "ts", "schema", "from_node", "to", "type", "payload_schema", "payload", "auth", "integrity"],
  "additionalProperties": false,
  "properties": {
    "msg_id": { "type": "string", "format": "uuid" },
    "ts": { "type": "string", "format": "date-time" },
    "schema": { "const": "envelope@1.0" },
    "from_node": { "type": "string" },
    "to": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "type": { "enum": ["task_assign", "artifact_publish", "debate_request", "debate_result", "gate_verdict", "control_event", "heartbeat", "succession_snapshot", "permission_request", "permission_verdict"] },
    "task_id": { "type": ["string", "null"] },
    "payload_schema": { "type": "string", "pattern": "^[a-z_]+@[0-9]+\\.[0-9]+$" },
    "payload": { "type": "object" },
    "auth": {
      "type": "object",
      "required": ["node_credential", "scope"],
      "additionalProperties": false,
      "properties": {
        "node_credential": { "type": "string" },
        "scope": { "type": "string", "description": "project/task/role scope claim; verified by Sovereign, not by MCP (I-M2)." }
      }
    },
    "integrity": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "hmac-sha256(payload)" }
  }
}
