{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sovereign.local/schemas/artifact@1.0",
  "title": "Content-addressed artifact metadata",
  "description": "Artifacts live in the content-addressed store (sha256-named blobs); this record is the DB-side metadata (Plan sections 4.5, 9.3). Acceptance lifecycle is carried by memory entries of kind artifact_ref, not here — the blob itself is immutable.",
  "type": "object",
  "required": ["artifact_id", "media_type", "size_bytes", "created_by_node", "ts"],
  "additionalProperties": false,
  "properties": {
    "artifact_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "media_type": { "type": "string", "description": "MIME type or logical type (text/markdown, application/json, code/patch...)" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "created_by_node": { "type": "string" },
    "task_id": { "type": ["string", "null"] },
    "ts": { "type": "string", "format": "date-time" },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store": { "const": "cas" },
        "path_hint": { "type": "string" }
      }
    },
    "provenance_entry": { "type": ["string", "null"], "description": "memory entry (kind=artifact_ref) carrying status + provenance" },
    "schema": { "const": "artifact@1.0" }
  }
}
