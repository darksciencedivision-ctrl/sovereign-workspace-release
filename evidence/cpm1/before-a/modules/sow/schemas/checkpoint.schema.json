{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sovereign.local/schemas/checkpoint@1.0",
  "title": "Checkpoint (succession snapshot / node-local checkpoint)",
  "description": "Architecture Plan v1.0.1 sections 9.11 and 19.1 (I-CS1). Succession snapshots are immutable MCP entries with an integrity hash; cadence = every major event + bounded interval (default 5 min, finalized P11). Node-local checkpoints support fail-closed disconnect (F5).",
  "type": "object",
  "required": ["checkpoint_id", "kind", "ts", "trigger"],
  "additionalProperties": false,
  "properties": {
    "checkpoint_id": { "type": "string", "pattern": "^s-[A-Za-z0-9_-]+$" },
    "kind": { "enum": ["succession_snapshot", "node_local"] },
    "ts": { "type": "string", "format": "date-time" },
    "trigger": { "enum": ["major_event", "interval", "disconnect", "manual"] },
    "tasks": { "type": ["string", "null"], "description": "task-graph version ref" },
    "nodes": { "type": ["string", "null"], "description": "node-registry version ref" },
    "debates": { "type": "array", "items": { "type": "string" }, "description": "open debate ids" },
    "gates": { "type": "array", "items": { "type": "string" }, "description": "pending gate ids" },
    "memory_heads": { "type": "object", "additionalProperties": { "type": ["string", "integer"] } },
    "routing": { "type": ["string", "null"], "description": "context-routing table ref" },
    "outstanding_issues": { "type": "array", "items": { "type": "string" } },
    "directive_version": { "type": ["string", "null"] },
    "conductor": { "$ref": "#/definitions/current_conductor" },
    "integrity": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "schema": { "const": "checkpoint@1.0" }
  },
  "definitions": {
    "current_conductor": {
      "$comment": "Canonical handoff 2.14.1 / Plan 9.11. Operator decision 2026-07-16: current selection = fable-5 (routine runtime-selection change under I-CN1; no architectural change).",
      "type": "object",
      "required": ["model", "reason", "since"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "description": "Runtime selection, e.g. fable-5. Never an architectural default (I-CN1)." },
        "adapter": { "type": ["string", "null"] },
        "reason": { "enum": ["operator_selected", "offline_mode", "succession"] },
        "since": { "type": "string", "format": "date-time" },
        "directive_version": { "type": ["string", "null"] },
        "subscription_ref": { "type": ["string", "null"] }
      }
    }
  }
}
