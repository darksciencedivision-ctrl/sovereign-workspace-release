{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sovereign.local/schemas/gate@1.0",
  "title": "Gate record",
  "description": "Architecture Plan v1.0.1 section 9.3. Failed artifacts cannot advance; dependents stay BLOCKED until PASS; the conductor has no override path (only the operator, logged).",
  "type": "object",
  "required": ["gate_id", "kind", "criteria"],
  "additionalProperties": false,
  "properties": {
    "gate_id": { "type": "string", "pattern": "^g-[A-Za-z0-9_-]+$" },
    "kind": { "enum": ["local", "stage", "plan", "acceptance"] },
    "criteria": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Declarative checks, stated before evaluation." },
    "verdict": { "enum": ["PASS", "PASS_WITH_RESERVATIONS", "FAIL", null] },
    "evidence": { "type": "array", "items": { "type": "string" }, "description": "evidence entry ids or artifact refs" },
    "debate_ref": { "type": ["string", "null"], "pattern": "^d-[A-Za-z0-9_-]+$" },
    "decided_by": { "enum": ["gate_engine", "operator", null] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "task_id": { "type": ["string", "null"], "description": "Traceability addition (justified: end-to-end reason tracing, Plan section 7 Phase 8)." },
    "schema": { "const": "gate@1.0" }
  }
}
