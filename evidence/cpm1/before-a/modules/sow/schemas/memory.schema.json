{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sovereign.local/schemas/memory@1.0",
  "title": "Shared memory entry (I-M3..M6)",
  "description": "Architecture Plan v1.0.1 section 9.4 + Canonical Handoff 2.10.3. Transitions are enforced server-side: workers may create CANDIDATE and move their own entries to UNDER_REVIEW; only the gate engine or an operator decision produces ACCEPTED*/REJECTED; SUPERSEDED requires a successor ref; nothing is deleted, only ARCHIVED.",
  "type": "object",
  "required": ["entry_id", "project_id", "tier", "kind", "status", "provenance", "content_hash", "version"],
  "additionalProperties": false,
  "properties": {
    "entry_id": { "type": "string", "pattern": "^m-[A-Za-z0-9_-]+$" },
    "project_id": { "type": "string" },
    "tier": { "enum": ["local_conversational", "shared_project", "private_node"] },
    "kind": { "enum": ["finding", "decision", "evidence", "artifact_ref", "directive", "conductor_file", "succession_state"] },
    "status": { "enum": ["CANDIDATE", "UNDER_REVIEW", "DISPUTED", "ACCEPTED", "ACCEPTED_WITH_RESERVATIONS", "REJECTED", "SUPERSEDED", "ARCHIVED"] },
    "provenance": { "$ref": "#/definitions/provenance" },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "version": { "type": "integer", "minimum": 1 },
    "prev_version_ref": { "type": ["string", "null"], "pattern": "^m-[A-Za-z0-9_-]+@[0-9]+$" },
    "schema": { "const": "memory@1.0" }
  },
  "definitions": {
    "provenance": {
      "$comment": "I-M5: provenance on every shared entry.",
      "type": "object",
      "required": ["author_node", "task_id", "ts", "directive_version", "confidence"],
      "additionalProperties": false,
      "properties": {
        "author_node": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "task_id": { "type": ["string", "null"] },
        "ts": { "type": "string", "format": "date-time" },
        "directive_version": { "type": "string" },
        "source_artifacts": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["high", "medium", "low"] },
        "reviewers": { "type": "array", "items": { "type": "string" } },
        "gate_result": { "type": ["string", "null"] },
        "supersedes": { "type": ["string", "null"] }
      }
    },
    "conflict_record": {
      "$comment": "Plan section 9.6 (D-MCP-03 recommendation): CAS failure creates an explicit conflict object; both versions preserved; review gate; never silent last-write-wins (invariant 13).",
      "type": "object",
      "required": ["conflict_id", "key", "expected_head", "found_head", "versions", "created_ts", "status"],
      "additionalProperties": false,
      "properties": {
        "conflict_id": { "type": "string", "pattern": "^c-[A-Za-z0-9_-]+$" },
        "key": { "type": "string", "description": "Logical key whose head pointer the CAS attempted to advance." },
        "expected_head": { "type": "string" },
        "found_head": { "type": "string" },
        "versions": { "type": "array", "minItems": 2, "items": { "type": "string" }, "description": "Both (all) preserved versions, by entry ref." },
        "created_ts": { "type": "string", "format": "date-time" },
        "status": { "enum": ["OPEN", "RESOLVED_SUPERSEDE", "RESOLVED_MERGE", "ESCALATED"] },
        "review_gate_id": { "type": ["string", "null"] }
      }
    }
  }
}
